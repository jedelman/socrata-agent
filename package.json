{
  "name": "socrata-agent",
  "version": "0.1.0",
  "description": "Ask a city's Socrata open data what's on your block, and who decided it. Every answer carries the queries behind it.",
  "type": "module",
  "license": "MIT",
  "repository": "github:jedelman/socrata-agent",
  "bin": {
    "socrata-agent": "bin/socrata-agent.js"
  },
  "files": [
    "bin",
    "src",
    "data",
    "!data/gaps/*.candidates.json",
    "!data/gaps/*.trace.json",
    "plugins",
    "deployments",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:norfolk": "node scripts/build-norfolk-legislation.js",
    "compare": "node scripts/compare-models.js",
    "verify:cases": "node scripts/verify-cases.js",
    "build:gaps": "node scripts/build-gaps.js",
    "check:gaps": "node scripts/build-gaps.js --check",
    "build:gaps:proposed": "node scripts/build-gaps-proposed.js",
    "find:gaps": "node scripts/find-gaps.js",
    "ingest": "node scripts/ingest-document.js"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0"
  }
}
